            "value" : "%@ can't be translated without its language pack. Download it to use it offline; the system handles the download."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有語言包就不能翻譯%@。下載後可以離線使用，下載由系統完成。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語パックがないと%@を翻訳できません。ダウンロードするとオフラインで使えます。ダウンロードはシステムが行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어 팩이 없으면 %@을(를) 번역할 수 없습니다. 다운로드하면 오프라인으로 사용할 수 있으며, 다운로드는 시스템에서 진행합니다."
          }
        }
      }
